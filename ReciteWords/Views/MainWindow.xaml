<Window x:Class="ReciteWords.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ReciteWords.Views" Style="{StaticResource {x:Type Window}}" Title="ReciteWords" Icon="/ReciteWords;component/ui/mainicon.png" Width="700" Height="850" MinWidth="440" MinHeight="370" WindowStartupLocation="Manual">
  <Window.Resources><Thickness x:Key="FilterTextIndent">0,0,0,0</Thickness></Window.Resources>
  <Grid x:Name="LayoutRoot" Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid x:Name="HeaderGrid" Margin="0,0,0,10">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" MinWidth="130" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
      <TextBlock Text="单词本" VerticalAlignment="Center" />
      <ComboBox x:Name="WordListCombo" Grid.Column="1" ItemsSource="{Binding WordLists}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedWordList, Mode=TwoWay}" AutomationProperties.AutomationId="WordList" />
      <Button x:Name="FolderButton" Grid.Column="2" Command="{Binding FolderCommand}" Margin="10,0,0,0" Padding="0" ToolTip="打开单词本文件夹" AutomationProperties.Name="打开单词本文件夹"><Image Source="{StaticResource OpenFolderIcon}" Width="24" Height="24" /></Button>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <TextBlock Text="{Binding WordHeading}" FontSize="16" FontWeight="SemiBold" Foreground="#b81a35" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0" VerticalAlignment="Center" />
    </Grid>
    <StackPanel x:Name="PhoneticRow" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
      <TextBlock x:Name="UkPhoneticLabel" Text="{Binding phonetic_uk}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <Button x:Name="WordUkButton" Content="🔊" Command="{Binding UkCommand}" Style="{StaticResource AudioButton}" ToolTip="单词英音" AutomationProperties.Name="播放单词英音" />
      <TextBlock x:Name="UsPhoneticLabel" Text="{Binding phonetic_us}" VerticalAlignment="Center" Margin="12,0,6,0" />
      <Button x:Name="WordUsButton" Content="🔊" Command="{Binding UsCommand}" Style="{StaticResource AudioButton}" ToolTip="单词美音" AutomationProperties.Name="播放单词美音" />
    </StackPanel>
    <Border x:Name="DefinitionBorder" Grid.Row="3" Background="White" BorderBrush="#D8E0E9" BorderThickness="1" CornerRadius="9">
      <Grid>
        <TextBlock Text="先回想词义，再点击“释义”查看。" Foreground="#A1ABB6" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding DefinitionVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <views:DefinitionView x:Name="Definition" Word="{Binding CurrentWord}" Visibility="{Binding DefinitionVisible, Converter={StaticResource BoolVisibility}}" />
      </Grid>
    </Border>
    <Grid x:Name="ReviewControls" Grid.Row="4" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" />
        <ColumnDefinition Width="32" /><ColumnDefinition Width="6" />
        <ColumnDefinition Width="32" /><ColumnDefinition Width="6" />
        <ColumnDefinition Width="32" /><ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" MinWidth="52" /><ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" MinWidth="52" /><ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" MinWidth="52" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="ReviewFilterCombo" Width="95" ItemsSource="{Binding Filters}" SelectedValuePath="Value" SelectedValue="{Binding SelectedFilter, Mode=TwoWay}" Padding="2,3">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Margin="{DynamicResource FilterTextIndent}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <Button x:Name="PreviousButton" Grid.Column="2" Command="{Binding PreviousCommand}" Padding="0" ToolTip="上一词" AutomationProperties.Name="上一词"><Image Source="{StaticResource PreviousWordIcon}" Width="24" Height="24" /></Button>
      <Button x:Name="NextButton" Grid.Column="4" Command="{Binding NextCommand}" Padding="0" ToolTip="下一词" AutomationProperties.Name="下一词"><Image Source="{StaticResource NextWordIcon}" Width="24" Height="24" /></Button>
      <Button x:Name="ExplanationButton" Grid.Column="6" Command="{Binding RevealCommand}" Padding="0" ToolTip="显示释义" AutomationProperties.Name="显示释义"><Image Source="{StaticResource ExplanationIcon}" Width="24" Height="24" /></Button>
      <Button x:Name="UnknownButton" Grid.Column="8" Content="不懂" Command="{Binding UnknownCommand}" Padding="4,3" />
      <Button Grid.Column="10" Content="认识" Command="{Binding FamiliarCommand}" Padding="4,3" />
      <Button Grid.Column="12" Content="掌握" Command="{Binding MasteredCommand}" Padding="4,3" />
    </Grid>
    <Grid x:Name="InformationBar" Grid.Row="5" Margin="0,12,0,0" Visibility="{Binding HasWarning, Converter={StaticResource BoolVisibility}}">
      <TextBlock x:Name="InformationText" Text="{Binding InformationText}" ToolTip="{Binding Warning}" TextTrimming="CharacterEllipsis" Foreground="#A06C24" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
